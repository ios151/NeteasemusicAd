#!name=网易云音乐去广告
#!desc=过滤网易云音乐广告，自定义底部/顶部 Tab
#!openUrl=https://apps.apple.com/app/id590338362
#!author=ios151[https://github.com/ios151]
#!tag=去广告
#!system=ios
#!loon_version=3.2.4(787)
#!homepage=https://github.com/ios151/NeteasemusicAd
#!icon=https://raw.githubusercontent.com/Keywos/rule/main/tv/app/144px/Netease.png
#!date=2026-04-30 15:05:00

[Argument]

# ===== 底部 Tab (1=隐藏, 0=显示) =====
FX = switch, false, true, tag=[底部 Tab] 隐藏发现, desc=
MY = switch, true, false, tag=[底部 Tab] 隐藏漫游, desc=
DT = switch, false, true, tag=[底部 Tab] 隐藏笔记, desc=
GZ = switch, true, false, tag=[底部 Tab] 隐藏关注, desc=
SOU = switch, true, false, tag=[底部 Tab] 隐藏搜索, desc=
SY_NAME = input, "", tag=[底部 Tab] 首页自定义名称, desc=留空保持原名
WD_NAME = input, "", tag=[底部 Tab] 我的自定义名称, desc=留空保持原名
MY_NAME = input, "", tag=[底部 Tab] 漫游自定义名称, desc=留空保持原名
DT_NAME = input, "", tag=[底部 Tab] 笔记自定义名称, desc=留空保持原名
FX_NAME = input, "", tag=[底部 Tab] 发现自定义名称, desc=留空保持原名

# ===== 顶部 Tab (1=显示, 0=隐藏) =====
XD = switch, true, false, tag=[顶部 Tab] 心动, desc=
BK = switch, true, false, tag=[顶部 Tab] 播客, desc=
TS = switch, true, false, tag=[顶部 Tab] 听书, desc=
HDTAB = switch, false, true, tag=[顶部 Tab] 显示活动 Tab, desc=

# ===== 首页卡片 (开启=显示) =====
PRGG = switch, false, true, tag=[首页] 问候语, desc=
PRDRD = switch, false, true, tag=[首页] 每日推荐, desc=
PRSCVPT = switch, false, true, tag=[首页] 推荐歌单, desc=
PRST = switch, false, true, tag=[首页] 最近常听, desc=
HMPR = switch, false, true, tag=[首页] 音乐合伙人, desc=
PRRR = switch, true, false, tag=[首页] 雷达歌单, desc=
PRRK = switch, false, true, tag=[首页] 排行榜, desc=
PRMST = switch, false, true, tag=[首页] 推荐专属歌单, desc=
PRCN = switch, true, false, tag=[首页] 你的专属歌单, desc=
PRPRS = switch, true, false, tag=[首页] 私房推荐歌曲, desc=
PRRSS = switch, true, false, tag=[首页] 红心相似歌曲, desc=


# ===== 调试 =====
LogLevel = select, "info", "off", "error", "warn", "debug", "all", tag=[调试] 日志级别, desc=排错时切到 debug 可看到 Settings/handler 内部日志

[Rule]
DOMAIN, iadmat.nosdn.127.net, REJECT
DOMAIN, iadmatapk.nosdn.127.net, REJECT
DOMAIN, iadmusicmat.music.126.net, REJECT
DOMAIN, iadmusicmatvideo.music.126.net, REJECT

[Script]
http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/(batch|v\d\/resource\/comment\/floor\/get|v1\/user\/info) script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=通用 (评论区/广告/红点), argument=LogLevel={LogLevel}

http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/sp\/flow\/popup\/query script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=免流推广弹窗清空, argument=LogLevel={LogLevel}

http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/home\/framework\/tab script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=底部 Tab, argument=FX={FX}&MY={MY}&DT={DT}&GZ={GZ}&SOU={SOU}&SY_NAME={SY_NAME}&WD_NAME={WD_NAME}&MY_NAME={MY_NAME}&DT_NAME={DT_NAME}&FX_NAME={FX_NAME}&LogLevel={LogLevel}

http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/home\/framework\/top\/tab script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=顶部 Tab, argument=XD={XD}&BK={BK}&TS={TS}&HDTAB={HDTAB}&LogLevel={LogLevel}

http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/vipactivity\/app\/cashier\/setting\/get script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=收银台广告, argument=LogLevel={LogLevel}

http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/(homepage\/block\/page|link\/page\/rcmd\/(resource\/show|block\/resource\/multi\/refresh)) script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=首页推荐, argument=PRGG={PRGG}&PRDRD={PRDRD}&PRSCVPT={PRSCVPT}&PRST={PRST}&HMPR={HMPR}&PRRR={PRRR}&PRRK={PRRK}&PRMST={PRMST}&PRCN={PRCN}&PRPRS={PRPRS}&PRRSS={PRRSS}&LogLevel={LogLevel}

http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/page\/discovery\/resource\/show script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=发现页, argument=LogLevel={LogLevel}

http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/position\/show\/resource script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=我的页面广告, argument=LogLevel={LogLevel}

http-response ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/user\/follow\/users\/mixed\/get script-path=https://raw.githubusercontent.com/ios151/NeteasemusicAd/main/wyyad.js, requires-body=true, binary-body-mode=true, timeout=20, tag=显示未关注你的人, argument=LogLevel={LogLevel}

[MitM]
hostname = ipv4.music.163.com, interface.music.163.com, interface*.music.163.com
